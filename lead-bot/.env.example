# Получи токен у @BotFather в Telegram: /newbot
BOT_TOKEN=123456789:AA-replace-this-with-your-real-token

# Твой личный Telegram chat_id (число).
# Получить: напиши /start боту @userinfobot, он выдаст твой Id.
# Сюда будут приходить уведомления о новых заявках.
ADMIN_CHAT_ID=123456789

# Путь к файлу базы (по умолчанию data/leads.db рядом с проектом).
DB_PATH=data/leads.db

# Название бизнеса/услуги, отображается в приветствии.
BUSINESS_NAME=Моя компания

# Список услуг для выбора в анкете (через ";")
SERVICES=Консультация;Заказ под ключ;Доработка проекта;Другое
