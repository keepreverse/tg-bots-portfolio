# Получи токен у @BotFather в Telegram: /newbot
BOT_TOKEN=123456789:AA-replace-this-with-your-real-token

# Твой личный Telegram chat_id (число).
# Получить: напиши /start боту @userinfobot, он выдаст твой Id.
# Сюда будут приходить уведомления о новых лидах и доступна 🛠 Админ-панель.
ADMIN_CHAT_ID=123456789

# Брендинг (меняешь под клиента — текст в /start и /help)
BUSINESS_NAME=Quiz Calculator
# Telegram-username, на который клиенты могут писать напрямую (без @).
# Бот построит ссылку вида https://t.me/<MASTER_HANDLE>.
MASTER_HANDLE=keepmaster

# Какой файл квиза грузим (по умолчанию data/seed_quiz.json).
# Чтобы перебрендировать под клиента — оставь имя файла, отредактируй сам JSON.
QUIZ_PATH=data/seed_quiz.json

# Хранилище
DB_PATH=data/quiz.db
