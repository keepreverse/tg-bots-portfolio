# Получи токен у @BotFather в Telegram: /newbot
BOT_TOKEN=123456789:AA-replace-this-with-your-real-token

# Твой личный Telegram chat_id (число).
# Получить: напиши /start боту @userinfobot, он выдаст твой Id.
# Сюда будут приходить уведомления о новых записях и доступна 🛠 Админ-панель.
ADMIN_CHAT_ID=123456789

# Брендинг (меняешь под клиента)
BUSINESS_NAME=Tattoo & Piercing
BUSINESS_ADDRESS=ул. Тверская, 7
# Telegram-username мастера (без @). Бот построит ссылку вида https://t.me/<MASTER_HANDLE>.
MASTER_HANDLE=keepmaster

# Расписание
MASTER_TZ=Europe/Moscow
SLOT_STEP_MINUTES=60
BOOKING_BUFFER_AFTER_MINUTES=30
BOOKING_HORIZON_DAYS=30
REMINDER_OFFSETS_HOURS=24,2

# Хранилище
DB_PATH=data/booking.db
